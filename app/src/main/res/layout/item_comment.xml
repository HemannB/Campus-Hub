<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="#F8FAFC"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="#E4E7EC"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/textCommentAuthor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#071A45"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textCommentDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#667085"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/textCommentBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:lineSpacingExtra="2dp"
            android:textColor="#344054"
            android:textSize="15sp" />

        <LinearLayout
            android:id="@+id/layoutCommentActions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonEditComment"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:text="Editar"
                android:textAllCaps="false"
                android:textColor="#1557D6" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonDeleteComment"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:text="Excluir"
                android:textAllCaps="false"
                android:textColor="#B42318" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
